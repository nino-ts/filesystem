    },
    "peerDependencies": {
        "typescript": "^7.0.0"
    },
    "exports": {
        ".": {
            "types": "./index.ts",
            "import": "./index.ts",
            "default": "./index.ts"
        }
    },
    "types": "./index.ts",
    "files": [
        "LICENSE",
        "README.md",
        "dist",
        "dist/index.d.ts",
